#!/usr/bin/env python3
"""fleet-view — a human-readable view of a fleet, built entirely on `--porcelain`.

    fleet-view                 the dashboard: subjects, then slots
    fleet-view board
    fleet-view leases
    fleet-view roadmap         needs --instant, or infers the coordinator
    fleet-view releases        what is deployed, what has been cut, and why it moved
    fleet-view --wide          do not truncate long notes
    fleet-view --cadence       show the cadence banner (hidden by default)
    fleet-view --no-color

WHY THIS IS A SEPARATE PROGRAM AND NOT A `--pretty` FLAG.

`fleet`'s human output is one padded-column formatter shared by every verb, and its porcelain form is a
DECLARED schema with tests asserting the exact column count per verb. Presentation wants the opposite of
both: terminal-width awareness, wrapping, dropped empty columns, colour, and rows that are grouped rather
than listed. Pushing that into the shared formatter would put layout decisions inside the tool whose job is
to be correct, and every one of them would be a new way for a verdict to render wrong.

So this reads `--porcelain` — the interface that exists precisely so something else can present it — and
owns none of the logic. It cannot change a state, cannot hide a refusal, and cannot disagree with `fleet`
about anything, because it computes nothing.

It imports `PORCELAIN_COLUMNS` from the package rather than hardcoding column order. Porcelain emits no
header row, so a consumer must know the schema; importing the declaration means adding a column to a verb
does not silently shift this view's fields by one. That is the one coupling worth having.
"""
import os
import re
import shutil
import subprocess
import sys

HERE = os.path.dirname(os.path.abspath(__file__))
REPO = os.path.dirname(HERE)
sys.path.insert(0, os.path.join(REPO, "fleet", "src"))

try:
    from fleet.cli import PORCELAIN_COLUMNS
except Exception:                                    # the view must never be the reason nothing renders
    PORCELAIN_COLUMNS = {}

FLEET = os.environ.get("FLEET_BIN") or os.path.join(REPO, "bin", "fleet")

# --- presentation ------------------------------------------------------------------------------------

COLOR = sys.stdout.isatty() and os.environ.get("NO_COLOR") is None
def _c(code, text):
    return f"\033[{code}m{text}\033[0m" if COLOR else text

DIM    = lambda t: _c("2", t)
BOLD   = lambda t: _c("1", t)
RED    = lambda t: _c("31", t)
GREEN  = lambda t: _c("32", t)
YELLOW = lambda t: _c("33", t)
BLUE   = lambda t: _c("36", t)

#: Every view this tool knows. Declared as data so the refusal in `main` and the usage text above cannot
#: drift apart — the same reason `cli.VERBS` is the one registry the product's unknown-verb message reads.
VIEWS = ("all", "board", "leases", "roadmap", "releases")

#: How each state reads at a glance. The mapping is deliberately coarse — the point of a dashboard is
#: "is anything wrong", and a palette with ten shades answers that no faster than one with three.
STATE_STYLE = {
    "RUNNING": (GREEN, "●"), "IDLE": (YELLOW, "○"), "BLOCKED": (RED, "!"),
    "PARKED": (YELLOW, "?"), "AWAITING-CI": (BLUE, "⋯"), "COMPLETE": (DIM, "✓"),
    "DEAD": (RED, "✗"), "UNREACHABLE": (YELLOW, "~"), "PENDING-LAUNCH": (DIM, "·"),
    "UNKNOWN-SESSION": (DIM, "·"), "STALE-LEASE": (YELLOW, "~"),
}

#: The same idea for the release register's `action` column. Coarse for the same reason: the question a
#: reader brings to a deploy history is "did something go backwards", and one glyph answers it.
ACTION_STYLE = {
    "DEPLOY": (GREEN, "↑"), "ROLLBACK": (RED, "↓"), "CUT": (DIM, "·"),
    "VERIFY": (BLUE, "⋯"), "PROMOTE": (GREEN, "✓"), "DEV": (YELLOW, "~"),
}

def width():
    env = os.environ.get("FLEET_VIEW_WIDTH")
    if env and env.isdigit():
        return int(env)
    return shutil.get_terminal_size((100, 24)).columns


def run(verb, extra=()):
    """One porcelain read. stderr is captured, not inherited, so the cadence banner is ours to place."""
    proc = subprocess.run([FLEET, verb, "--porcelain", *extra],
                          capture_output=True, text=True)
    rows = []
    cols = PORCELAIN_COLUMNS.get(verb)
    for line in proc.stdout.splitlines():
        if not line.strip():
            continue
        parts = line.split("\t")
        rows.append(dict(zip(cols, parts)) if cols else {"raw": line})
    return rows, proc.stderr, proc.returncode


_ANSI = re.compile(r"\033\[[0-9;]*m")
def _vlen(text):
    """Visible width: what the terminal shows, not what the string contains."""
    return len(_ANSI.sub("", str(text)))


def wrap(text, budget, indent):
    """Wrap to `budget`, continuation lines indented by `indent`. Long unbroken tokens are left alone —
    a path split across lines is worse than a line that runs long, because it stops being copy-pasteable."""
    if budget < 20:
        return [text]
    out, line = [], ""
    for word in str(text).split():
        if line and len(line) + 1 + len(word) > budget:
            out.append(line)
            line = word
        else:
            line = f"{line} {word}".strip()
    if line:
        out.append(line)
    return [out[0]] + [" " * indent + l for l in out[1:]] if out else [""]


def shorten(value, cap):
    """Fit a value into `cap` visible columns.

    A PATH is elided from the LEFT (`…/00000000-…-v2stackcoordinator`), because the informative part of an
    instant path is its tail and the leading directories are identical for every row. Anything else is cut
    from the right. Without this one long path sets the column width for the whole table and squeezes every
    other column to nothing — which is exactly what the roadmap's `population` row did.
    """
    value = str(value)
    if _vlen(value) <= cap:
        return value
    if "/" in value:
        parts = value.split("/")
        out = parts[-1]
        for part in reversed(parts[:-1]):
            candidate = f"{part}/{out}"
            if len(candidate) + 2 > cap:
                break
            out = candidate
        return "…/" + out if len(out) + 2 <= cap else "…" + out[-(cap - 1):]
    return value[:cap - 1] + "…"


def table(rows, columns, note_column=None, wide=False):
    """Aligned columns, with one column allowed to wrap under a hanging indent.

    Columns that are empty in EVERY row are dropped: a table of `-` teaches a reader to skip columns,
    and the one time it matters they skip it too.
    """
    if not rows:
        return []
    cols = [c for c in columns
            if c != note_column and any((r.get(c) or "").strip() not in ("", "-") for r in rows)]
    # Width is measured on VISIBLE text. An ANSI escape is zero columns wide on screen and several
    # characters long in the string, so padding by len() silently skews every colourised column.
    # No single column may eat the line. 35% is enough for an instant name and leaves the note readable.
    cap = max(12, int(width() * 0.35))
    for r in rows:
        for c in cols:
            if c in r and not wide:
                r[c] = shorten(r.get(c) or "", cap)
    w = {c: max(len(c), max(_vlen(r.get(c, "") or "") for r in rows)) for c in cols}
    total = 2 + sum(w[c] + 2 for c in cols)
    budget = max(20, width() - total)

    out = [DIM("  " + "  ".join(c.upper().ljust(w[c]) for c in cols)
               + ("  " + note_column.upper() if note_column else ""))]
    for r in rows:
        cells = []
        for c in cols:
            v = (r.get(c) or "") or "-"
            style = r.get("_style")
            pad = " " * max(0, w[c] - _vlen(v))
            cells.append((style(v) if (style and c == r.get("_style_col")) else v) + pad)
        line = "  " + "  ".join(cells)
        if note_column:
            note = (r.get(note_column) or "").strip()
            if note and note not in ("-",):
                if wide:
                    for i, seg in enumerate(wrap(note, budget, total)):
                        line = (line + "  " + seg) if i == 0 else line + "\n" + seg
                else:
                    line += "  " + DIM(note[:budget - 1] + ("…" if len(note) > budget else ""))
        out.append(line.rstrip())
    return out


def blocks(entries):
    """One block per row: a headline, a metadata line, then the note in full.

    A table is the wrong shape for these. Its column width is set by the LONGEST value, so one three-
    sentence `UNREACHABLE` explanation either squeezes every other column or gets cut — and the note is
    the part you actually came to read. `reconcile`'s notes are prose by design (they name what was
    measured and what clears it), so they get the width of the terminal instead of the leftovers.

    Slots stay a table: short, uniform, scannable, and nothing there is prose.
    """
    out, w = [], width()
    # Width from the data, not a guess: `pending-proposal` is 16 and a hardcoded 11 silently ragged every
    # roadmap row.
    sw = max((len(e["state"]) for e in entries), default=0)
    for e in entries:
        style, glyph = e["style"], e["glyph"]
        pad = " " * max(0, sw - len(e["state"]))
        out.append(f"  {glyph}  {style(e['state'])}{pad}  {BOLD(e['subject'])}")
        meta = " · ".join(x for x in e["meta"] if x)
        if meta:
            out.append(DIM(f"        {meta}"))
        note = (e.get("note") or "").strip()
        if note and note != "-":
            for line in wrap(note, w - 8, 0):
                out.append(DIM(f"        {line}"))
        out.append("")
    return out[:-1] if out else ["  (nothing)"]


# --- views -------------------------------------------------------------------------------------------

def _find_session(name):
    """Which tmux SERVER has this session, if any.

    `UNREACHABLE` means "a process holds the slot but no session answers here", and the remedy is always a
    socket name — so the view goes and finds it rather than telling the reader to. tmux keeps one socket
    file per server under $TMUX_TMPDIR|/tmp/tmux-<uid>, so the candidates are simply readable.

    Only called when something is already UNREACHABLE, which is rare: it costs one `has-session` per
    server, and doing that on every render would put ~30 subprocesses in the way of a healthy board.
    """
    if not name:
        return None
    base = os.environ.get("TMUX_TMPDIR") or "/tmp"
    d = os.path.join(base, f"tmux-{os.getuid()}")
    try:
        candidates = sorted(os.listdir(d))
    except OSError:
        return None
    for sock in candidates:
        if sock == os.environ.get("FLEET_TMUX_SOCKET"):
            continue                      # already asked; that is why we are here
        r = subprocess.run(["tmux", "-L", sock, "has-session", "-t", f"={name}"],
                           capture_output=True, text=True)
        if r.returncode == 0:
            return sock
    return None


def _session_name(subject_id):
    """The record's tmux name, read as a FIELD from `status` rather than scraped out of a note."""
    rows, _, _ = run("status", ("--id", subject_id))
    for r in rows:
        if r.get("field") == "evidence.tmux":
            return r.get("value") or ""
    return ""


def _collapse(rows):
    """Fold each unknown-session row into the record that leases the same slot.

    `reconcile` reports process-first and record-second, so ONE process can surface twice: once as
    `session:pid…  UNKNOWN-SESSION  ws3  no dispatch record claims this session`, and once as the record
    that does lease ws3. Both are honest about what their own pass saw and together they contradict each
    other, which is confusing exactly when you are already confused — the usual cause is being pointed at
    the wrong tmux server.

    Folding is presentational and reversible: the pid moves onto the record's row, and nothing is dropped
    that `fleet board` would have shown. An unknown session whose slot NO record claims is left alone,
    because that one is a real finding (`D-6`: an unmanaged session is reported, never acted on).
    """
    leased = {r.get("slot") for r in rows
              if r.get("kind") == "worker" and (r.get("slot") or "").strip()}
    kept, folded = [], {}
    for r in rows:
        if r.get("state") == "UNKNOWN-SESSION" and r.get("slot") in leased:
            pid = re.search(r"pid(\d+)|:(\d+)$", r.get("identity", ""))
            folded[r["slot"]] = (pid.group(1) or pid.group(2)) if pid else "?"
            continue
        kept.append(r)
    for r in kept:
        if r.get("slot") in folded and r.get("kind") == "worker":
            r["_folded_pid"] = folded[r["slot"]]
    return kept


def view_board(wide):
    rows, err, _ = run("board")
    rows = _collapse(rows)
    if not rows:
        return ["  (no subjects)"], err
    entries = []
    for r in rows:
        state = r.get("state", "")
        style, glyph = STATE_STYLE.get(state, (lambda t: t, " "))
        note = r.get("note", "")
        pid = r.get("_folded_pid")
        if pid and f"pid {pid}" not in note:
            note = f"pid {pid} · {note}" if note.strip() else f"pid {pid}"
        if state == "UNREACHABLE":
            found = _find_session(_session_name(r.get("identity", "")))
            if found:
                note += (f"  →  FOUND IT on socket '{found}'. Run: "
                         f"export FLEET_TMUX_SOCKET={found}   (then re-run; "
                         f"attach with tmux -L {found} attach -t <session>)")
            else:
                note += "  →  no tmux server on this box has that session; the work may be running outside tmux."
        entries.append({"state": state, "subject": r.get("identity", ""), "style": style, "glyph": glyph,
                        "meta": [r.get("slot", ""), r.get("milestone", "")], "note": note})
    return blocks(entries), err


def view_leases(wide):
    rows, err, _ = run("leases")
    if not rows:
        return ["  (no slots enrolled)"], err
    body = []
    for r in rows:
        held = r.get("lease") == "held"
        body.append({"slot": r.get("slot", ""),
                     "lease": GREEN("held") if held else DIM("free"),
                     "holder": r.get("todo_id", "") if held else "",
                     "session": r.get("tmux", "") if held else "",
                     "since": (r.get("claimed_at", "") or "")[11:16] if held else "",
                     "path": r.get("path", "") if held else ""})
    # The path is dropped unless asked for: it is the one column that cannot be usefully truncated, and a
    # path cut mid-directory is worse than no path -- it looks copy-pasteable and is not.
    return table(body, ("slot", "lease", "holder", "session", "since"),
                 "path" if wide else None, wide), err


def view_roadmap(wide, extra):
    rows, err, rc = run("roadmap", extra)
    if rc != 0 and not rows:
        return ["  " + DIM((err or "roadmap needs --instant").strip().splitlines()[-1][:width() - 4])], ""
    entries = []
    for r in rows:
        sev = r.get("severity", "")
        style = RED if sev == "violation" else (YELLOW if sev == "attention" else DIM)
        glyph = "!" if sev == "violation" else ("•" if sev == "attention" else "·")
        entries.append({"state": r.get("kind", ""), "subject": r.get("subject", ""), "style": style,
                        "glyph": glyph, "meta": [r.get("clears_who", "")], "note": r.get("detail", "")})
    return blocks(entries), err


def view_releases(wide):
    """What is deployed, what has been cut, and why the pointer last moved.

    Three porcelain reads, laid out. Nothing here decides anything: `current`, every state and every
    history row are read as FIELDS off `release-status`, `release-list` and `release-history`. Porcelain
    emits no header row, so every row returned is data — slicing the first one off would silently hide the
    oldest release and the oldest history entry.

    The history is a LIST, not a table. `reason` is operator free text, written down at the moment of a
    rollback precisely so it would not be lost, and every table in this file elides a value to fit — one
    column cap away from cutting the sentence in half. The releases and the deployed pointer stay tabular
    and key/value: those fields are short, uniform, and nothing in them is prose.
    """
    status, err, _ = run("release-status")
    listing, listing_err, _ = run("release-list")
    history, history_err, _ = run("release-history", ("--limit", "10"))
    w = width()

    out = []
    if status:
        kw = max(len(r.get("field", "")) for r in status)
        for r in status:
            value = (r.get("value") or "").strip() or "-"
            head = "  " + DIM(r.get("field", "").ljust(kw)) + "  "
            for i, line in enumerate(wrap(value, max(20, w - kw - 4), kw + 4)):
                out.append(head + line if i == 0 else line)
    else:
        out.append("  " + DIM("(nothing deployed)"))

    out.append(BOLD("\nRELEASES"))
    if listing:
        out.extend(table([{"version": r.get("version", ""), "state": r.get("state", ""),
                           "cut_at": r.get("cut_at", ""), "current": r.get("current", ""),
                           "_style": GREEN, "_style_col": "current"} for r in listing],
                         ("version", "state", "cut_at", "current"), None, wide))
    else:
        out.append("  " + DIM("(nothing cut)"))

    out.append(BOLD("\nHISTORY (most recent last)"))
    entries = []
    for r in history:
        action = r.get("action", "")
        style, glyph = ACTION_STYLE.get(action, (lambda t: t, " "))
        was, now = r.get("from_version", "") or "-", r.get("version", "") or "-"
        evidence = (r.get("evidence") or "").strip()
        entries.append({"state": action, "subject": f"{was} → {now}", "style": style, "glyph": glyph,
                        "meta": [r.get("ts", ""), r.get("actor", ""), r.get("host", ""),
                                 evidence if evidence not in ("", "-") else ""],
                        "note": r.get("reason", "")})
    out.extend(blocks(entries) if entries else ["  " + DIM("(nothing deployed yet)")])
    return out, err or listing_err or history_err


def main():
    args = [a for a in sys.argv[1:]]
    wide = "--wide" in args;      args = [a for a in args if a != "--wide"]
    show_cadence = "--cadence" in args; args = [a for a in args if a != "--cadence"]
    if "--no-color" in args:
        globals()["COLOR"] = False
        args = [a for a in args if a != "--no-color"]
    verb = args[0] if args and not args[0].startswith("-") else "all"
    extra = args[1:] if args and not args[0].startswith("-") else args

    home = os.environ.get("FLEET_HOME", "(unset — defaults to ~/.fleet for reads)")
    sock = os.environ.get("FLEET_TMUX_SOCKET")
    head = f"store {home}"
    if sock:
        head += f" · tmux -L {sock}"
    else:
        # The single most common reason this view looks wrong, so it is stated up front rather than
        # inferred from a row that says UNREACHABLE.
        head += " · " + YELLOW("no FLEET_TMUX_SOCKET: dispatched sessions read UNREACHABLE. "
                               "Fix: open a new shell in davis_root, or "
                               "`source ~/davis_root/superpowers/scripts/fleet-env.sh`")
    # The header wraps like everything else. It is the longest line on an otherwise-empty fleet, and an
    # overflowing header is the first thing a reader sees go wrong.
    print(DIM("\n".join(wrap(head, width(), 0))))

    # A view nobody declares is refused, exit 2, the same answer `fleet` gives an unknown verb. Before
    # this, every unrecognised word fell through all four branches, printed the header and exited 0 — so
    # `fleet-view releases` exited 0 for the whole time before the releases view existed, and every
    # `check "the … view renders" "0" "$rc"` assertion in the test file passed vacuously. A viewer that
    # answers "fine" to a word it does not know teaches you to trust a blank screen.
    if verb not in VIEWS:
        print(f"{verb!r} is not a fleet-view view. The views are: " + ", ".join(sorted(VIEWS)) + ".",
              file=sys.stderr)
        return 2

    errs = []
    if verb in ("all", "board"):
        print(BOLD("\nSUBJECTS"))
        lines, err = view_board(wide); errs.append(err); print("\n".join(lines))
    if verb in ("all", "leases"):
        print(BOLD("\nSLOTS"))
        lines, err = view_leases(wide); errs.append(err); print("\n".join(lines))
    if verb == "roadmap":
        print(BOLD("\nROADMAP"))
        lines, err = view_roadmap(wide, extra); errs.append(err); print("\n".join(lines))
    if verb == "releases":
        print(BOLD("\nDEPLOYED"))
        lines, err = view_releases(wide); errs.append(err); print("\n".join(lines))

    if show_cadence:
        for err in errs:
            for line in (err or "").splitlines():
                if line.startswith("cadence:"):
                    print("\n" + DIM("\n".join(wrap(line, width() - 2, 2))))
                    break
            else:
                continue
            break
    print()


if __name__ == "__main__":
    try:
        sys.exit(main() or 0)
    except BrokenPipeError:
        pass
