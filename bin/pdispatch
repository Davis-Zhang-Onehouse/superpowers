#!/usr/bin/env bash
#
# pdispatch — entry point for the parallel-TODO dispatch toolkit (skill: dispatchInstants).
#
# Runs from anywhere (this dir is on PATH and ships with the superpowers repo). With no
# args it prints the toolkit map + the end-to-end use case. Subcommands route to the tools.
#
set -euo pipefail
SELF="$(readlink -f "$0" 2>/dev/null || echo "$0")"
BIN_DIR="$(cd "$(dirname "$SELF")" && pwd)"
REPO="$(cd "$BIN_DIR/.." && pwd)"
SKILL="$REPO/skills/dispatchInstants"

b=$'\033[1m'; d=$'\033[2m'; g=$'\033[32m'; y=$'\033[33m'; c=$'\033[36m'; r=$'\033[0m'

overview() {
cat <<EOF
${b}parallel-TODO dispatch${r}  ${d}(skill: dispatchInstants — $SKILL)${r}

Turn ONE base ${b}effort-workspace instant${r} that has produced a solid base + many independent
TODOs (e.g. a ranked list of ANSI gaps) into MANY parallel, interactive workers — each in its
own pre-built workspace (~/wsN, no rebuild) and its own forked child instant, RCA-first,
reporting back onto the base.

${b}TWO DECOUPLED RESOURCES${r}
  ${c}instant${r}  = state  (charter/HANDOFF/RCA/evidence). Forked off the base; permanent.
  ${c}slot${r}     = code   (a ~/wsN checkout). Leased → worked → released → re-leased.
  A TODO = one child instant ${b}leasing${r} one slot. The base instant is the bulletin board.

${b}THE TOOLKIT${r}  ${d}(all on PATH via this repo's bin/)${r}
  ${g}pdispatch pool${r}  <add|list|status|claim|release|reap>   lease manager over an OPT-IN
                                                        set of ~/wsN slots. Atomic (mkdir),
                                                        crash-safe (dead-tmux reap).
  ${g}pdispatch todo${r}  --base <instant> --profile <name> --title .. --brief ..
                                                        dispatch ONE FRESH TODO: claim slot →
                                                        duplicate golden (no rebuild) → fork
                                                        child instant + render CHARTER/SEED from
                                                        the chosen profile → launch interactive
                                                        tmux claude → record it. Clean rollback
                                                        on failure. --profile is REQUIRED (the
                                                        CHARTER+SEED content; see profiles/).
  ${g}pdispatch adopt${r} --base <instant> --instant <existing> --slot <ws> [--resume <uuid>]
                                                        adopt an EXISTING instant (resumed /
                                                        migrated / hand-made) into the pool +
                                                        board WITHOUT recreating it: claim lease →
                                                        adopt-live-or-relaunch+resume session →
                                                        write record. Idempotent.
  ${g}pdispatch health${r}                                       per-worker DEAD / BLOCKED / IDLE /
                                                        COMPLETE-unharvested. Run it every tick;
                                                        exit 1 = something needs you.
  ${g}pdispatch alive${r} <todo-id>                             is that session alive? answered from the
                                                        RECORD — never hand-derive 'dt-<id>'.
  ${g}pdispatch send${r} <todo-id> <msg>                        message a worker and VERIFY it landed.
  ${g}pdispatch launch${r} <todo-id>                            launch from the RECORDED seed (never
                                                        hand-build a launch line).
  ${g}pdispatch close${r} <todo-id> [--force]                   the counterpart to launch: tear the
                                                        session down, stamp closed_at, free the slot,
                                                        disarm its auto-retry monitor. Refuses a busy
                                                        pane or unsubmitted input in the box.
  ${g}pdispatch sessions${r} [--reap]                           every LIVE claude session, then who the
                                                        board says owns it: ACTIVE / FINISHED /
                                                        UNCLAIMED. Finds strays no record mentions.
                                                        exit 1 = a FINISHED session is past its TTL.
  ${g}pdispatch gate${r} <instant> [--harvest]                  mechanical review gate: pass/fail from
                                                        REVIEW.md. Precondition for harvesting.
  ${g}pdispatch drift${r} --handoff <f> --instants-dir <d>      registry-vs-reality drift check.
  ${g}pdispatch endgame${r} <coordinator-instant>                 leave-no-orphans check before you STOP,
                                                        plus the manual steps it cannot verify.
  ${g}pdispatch lint${r} <instant>                              canonical file SET present? (a format
                                                        review checks content of files that EXIST.)
  ${g}pdispatch surefire${r} <dir>... [--dim <label>]            flatten surefire/JUnit XML to the
                                                        name+PASS/FAIL shape regress eats. Use this
                                                        instead of hand-rolling a regex adapter.
  ${g}pdispatch regress${r} --baseline B --current C ...        two-diff non-regression check.
  ${g}pdispatch guard${r} <repo> <branch>...                    pre-push hook: refuse shared-branch pushes.
  ${g}pdispatch ref${r} check|protect|worktree <ref>            keep shared reference checkouts read-only.
  ${g}pdispatch board${r}                                        derived fleet dashboard (NO path —
                                                        global, like 'pool list'): rows grouped by
                                                        base; running / 🅿 parked / ✅ complete / ✖ abort.
                                                        Records live in ~/.claude-dispatch-board/.
  ${g}pdispatch doc${r}                                          show the SKILL.md + design spec.

${b}RELATED SKILLS IT BUILDS ON${r}  ${d}(all in this repo — checkout & go)${r}
  superpowers:maintain-workspace     the instant model (fork / state-rename / cold resume).
  superpowers:duplicateWorkSpace     fast, no-rebuild ~/wsN checkout (claim-time duplication).
  superpowers:systematic-debugging   each worker runs this FIRST → the RCA (gold vs actual).

${b}END-TO-END USE CASE${r}
  0. one-time:  ${g}pdispatch pool add ~/ws5 ~/ws6${r}   ${d}# enroll ONLY genuinely-free slots${r}
                ${g}echo ~/ws1 > ~/.claude-ws-pool/golden${r}  ${d}# the pre-built source${r}
  1. per TODO:  ${g}pdispatch todo --base <base-instant> --title "close gap X" \\ ${r}
                ${g}               --brief brief.md --golden ~/ws1 --evidence "RANKING.md#1"${r}
                → a real interactive ${b}claude${r} starts in tmux, seeded to run RCA-first, then
                  branch on scope (small→TDD; large→brainstorm→plan→subagents), autonomously,
                  parking a decision only when it genuinely needs you.
  2. watch:     ${g}pdispatch board${r}   ${d}# global; no path — shows every base's fleet${r}
  3. answer:    ${g}tmux attach -t dt-<id>${r}   ${d}# only sessions flagged 🅿 PARKED${r}
  4. recycle:   ${g}pdispatch pool release ws5${r}  ${d}# after its TODO is merged; slot re-leases${r}
                ${g}pdispatch pool reap${r}         ${d}# reclaim a crashed session's slot${r}

${d}Design & rationale: $SKILL/docs/  ·  proofs: the parallelDispatch effort instant's evidence/${r}
EOF
}

cmd="${1:-help}"; shift || true
case "$cmd" in
  pool)    exec "$SKILL/wspool.sh" "$@";;
  todo)    exec "$SKILL/dispatch-todo.sh" "$@";;
  adopt)   exec "$SKILL/dispatch-adopt.sh" "$@";;
  board)   exec "$SKILL/dispatch-board.sh" "$@";;
  health)  exec "$SKILL/dispatch-health.sh" "$@";;
  alive)   exec "$SKILL/dispatch-alive.sh" "$@";;
  send)    exec "$SKILL/dispatch-send.sh" "$@";;
  launch)  exec "$SKILL/dispatch-launch.sh" "$@";;
  close)   exec "$SKILL/dispatch-close.sh" "$@";;
  sessions) exec "$SKILL/dispatch-sessions.sh" "$@";;
  guard)   exec "$SKILL/install-branch-guard.sh" "$@";;
  ref)     exec "$SKILL/ref-guard.sh" "$@";;
  profile) exec "$SKILL/profile-check.sh" "$@";;
  basecheck) exec "$SKILL/base-check.sh" "$@";;
  issues)  exec "$REPO/skills/coordinating-instants/tools/new-issues.py" "$@";;
  gate)    exec "$REPO/skills/coordinating-instants/tools/workspace-gate.py" "$@";;
  drift)   exec "$REPO/skills/coordinating-instants/tools/coord-check.py" "$@";;
  lint)    exec "$REPO/skills/coordinating-instants/tools/workspace-lint.py" "$@";;
  endgame) exec "$REPO/skills/coordinating-instants/tools/endgame-check.py" "$@";;
  regress) exec "$REPO/skills/coordinating-instants/tools/regression-check.py" "$@";;
  surefire) exec "$REPO/skills/coordinating-instants/tools/surefire-to-tsv.py" "$@";;
  doc|docs|design)
           echo "SKILL.md : $SKILL/SKILL.md"
           echo "design   : $SKILL/docs/"
           ls "$SKILL/docs/" 2>/dev/null | sed 's/^/  - /'
           echo; sed -n '1,60p' "$SKILL/SKILL.md";;
  help|-h|--help|"") overview;;
  *) echo "pdispatch: unknown subcommand '$cmd'" >&2; echo; overview; exit 2;;
esac
