{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "^(startup|resume|clear|compact)$",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${PLUGIN_ROOT}/hooks/session-start-codex\"",
            "async": false,
            "additionalContextLimit": 0
          }
        ]
      }
    ]
  }
}
