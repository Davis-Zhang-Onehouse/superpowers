 // can't rely on its own $TMUX (a status-bar `#()` command runs in the tmux *server's*
 // environment, not a client's — see the README PATH caveat), so it instead receives
 // `#{socket_path}` as an explicit argument, which resolves to the same value.
+//
+// LOCAL PATCH. The paragraph above states the assumption this breaks: "The monitor is forked from a
+// process running inside the pane it's watching, so it reliably inherits this." A monitor armed by
+// `reconcile` is NOT — it is spawned by whatever shell ran the CLI, and inherits THAT server's $TMUX.
+//
+// Within one server that is harmless, because the socket id is the same either way. Across servers it is
+// exactly the collision this function exists to prevent: a monitor watching `%0` on `-L fleet`, armed from
+// a shell sitting in the default server, wrote `_tmp_tmux-1000_default__0.json` — the default server's
+// namespace, for a pane that is not in it. Observed, not theorised.
+//
+// So an explicitly named server wins over the ambient one. The socket NAME is resolved to the same path
+// tmux itself would use (`$TMUX_TMPDIR|/tmp` + `/tmux-<uid>/<name>`), so this agrees with the
+// `#{socket_path}` the reader script is handed rather than inventing a second key format.
+function socketPathForName(name, env = process.env) {
+  const base = env.TMUX_TMPDIR || '/tmp';
+  const uid = typeof process.getuid === 'function' ? process.getuid() : '';
+  return `${base}/tmux-${uid}/${name}`;
+}
+
 function socketIdFromEnv(env = process.env) {
+  const named = env.CLAUDE_AUTO_RETRY_TMUX_SOCKET;
+  if (named) return socketPathForName(named, env);
   const tmuxEnv = env.TMUX || '';
   return tmuxEnv.split(',')[0] || 'default';
 }
