 const execFileAsync = promisify(execFileCb);
 
+// --- tmux SERVER selection (local patch; see superpowers/patches/claude-auto-retry) -----------------
+//
+// Upstream invokes `tmux` with no server option, so every call lands on the DEFAULT server. That is
+// correct for the common case and wrong for ours: dispatched agent sessions are deliberately started on
+// a private server (`tmux -L <socket>`) so that killing a session by name cannot reach another person's
+// live work, and so a long-lived default server cannot hand new sessions a stale environment.
+//
+// Without this, `reconcile` sees no panes on that server and NOTHING dispatched is ever auto-resumed —
+// silently, because "no panes" and "no panes needing help" produce identical output.
+//
+// One resolution point, applied at the exec boundary rather than inside each builder: the builders stay
+// pure (their unit tests assert exact argv) and no future call site can forget the prefix.
+//
+// `-L` is a SERVER option and tmux requires it BEFORE the subcommand.
+const TMUX_SOCKET = process.env.CLAUDE_AUTO_RETRY_TMUX_SOCKET || '';
+export function tmuxArgv(args) {
+  return TMUX_SOCKET ? ['-L', TMUX_SOCKET, ...args] : args;
+}
+
 export function buildCaptureArgs(pane, lines = 200) {
   return ['capture-pane', '-t', pane, '-p', '-S', `-${lines}`];
 }
