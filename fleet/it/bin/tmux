#!/usr/bin/env python3
"""IT tmux boundary: log argv/socket and refuse unowned destructive calls before exec."""

import fcntl
import json
import os
import re
import subprocess
import sys
import tempfile


def parse(argv):
    socket = None
    name = None
    i = 0
    while i < len(argv) and argv[i].startswith("-") and argv[i] not in ("-", "--"):
        option = argv[i]
        for offset, flag in enumerate(option[1:], 1):
            if flag in "cfLST":
                value = option[offset + 1:]
                if not value:
                    i += 1
                    value = argv[i] if i < len(argv) else ""
                if flag == "S":
                    socket = value
                elif flag == "L":
                    name = value
                break
        i += 1
    command = argv[i] if i < len(argv) else ""
    # tmux accepts unique command prefixes. Treat even an ambiguous kill prefix as destructive;
    # real tmux may reject it, but the audit must never pass a recognized kill spelling through.
    if command and "kill-server".startswith(command) and not "kill-session".startswith(command):
        command = "kill-server"
    elif command and "kill-session".startswith(command):
        command = "kill-session"
    rest = argv[i + 1:]
    directory = os.environ.get("TMUX_TMPDIR") or "/tmp"
    if not os.path.isdir(directory):
        directory = "/tmp"
    if socket is None:
        if name:
            socket = os.path.join(directory, f"tmux-{os.getuid()}", name)
        elif os.environ.get("TMUX"):
            socket = os.environ["TMUX"].split(",", 1)[0]
        else:
            socket = os.path.join(directory, f"tmux-{os.getuid()}", "default")
    return os.path.realpath(socket), command, rest


def option(rest, flag):
    for i, arg in enumerate(rest):
        if arg == flag and i + 1 < len(rest):
            return rest[i + 1]
        if arg.startswith(flag) and len(arg) > len(flag):
            return arg[len(flag):]
    return None


def nested_kills(rest):
    """Find kill words in arguments that tmux could execute as a later command."""
    found = []
    for arg in rest:
        for word in re.findall(r"[A-Za-z][A-Za-z-]*", arg):
            if len(word) >= 6 and "kill-server".startswith(word) and not "kill-session".startswith(word):
                found.append("kill-server")
            elif len(word) >= 6 and "kill-session".startswith(word):
                found.append("kill-session")
    return found


def can_dispatch_commands(command, rest):
    # A compound argv can execute a later command after the first one. These tmux commands can
    # execute commands supplied as arguments or from a file; their effect is not proved by argv[0].
    dispatchers = ("source-file", "if-shell", "confirm-before", "run-shell", "bind-key",
                   "set-hook", "command-prompt", "display-menu", "display-popup")
    return any(";" in arg for arg in rest) or bool(command and any(
        name.startswith(command) for name in dispatchers))


def server_pid(real, socket):
    try:
        found = subprocess.run([real, "-S", socket, "display-message", "-p", "#{pid}"],
                               capture_output=True, text=True, timeout=2)
    except subprocess.TimeoutExpired:
        return None
    return found.stdout.strip() if found.returncode == 0 else None


def session_id(real, socket, name):
    try:
        found = subprocess.run([real, "-S", socket, "list-sessions", "-F",
                                "#{session_name}\t#{session_id}"], capture_output=True, text=True, timeout=2)
    except subprocess.TimeoutExpired:
        return None
    if found.returncode == 0:
        for line in found.stdout.splitlines():
            listed_name, _, listed_id = line.partition("\t")
            if listed_name == name and listed_id:
                return listed_id
    return None


def refresh_result(rows):
    """A runner may kill in its EXIT trap, after its leave row was written."""
    path = os.environ.get("IT_TMUX_AUDIT_RESULTS")
    section = os.environ.get("IT_TMUX_AUDIT_SECTION")
    if not path or not section or not os.path.isfile(path):
        return
    case = f"KILL-AUDIT-{os.environ.get('IT_TMUX_AUDIT_CASE_SECTION') or section}"
    with open(path, encoding="utf-8") as source:
        lines = source.readlines()
    if not any(line.startswith(case + "\t") for line in lines):
        return
    kills = [r for r in rows if r["command"] in ("kill-server", "kill-session")]
    names = [r["command"] + "@" + os.path.basename(r["socket"]) +
             (":" + str(r["target"]) if r["target"] else "") + "[" + r["decision"] + "]"
             for r in kills]
    verdict = "FAIL" if any(r["decision"] == "deny" for r in kills) else "PASS"
    note = f"{len(kills)} kill(s): " + (", ".join(names) if names else "(none)")
    replacement = f"{case}\t{verdict}\tfleet/it/{section}/tmux-audit.jsonl\t{note}\n"
    fd, temporary = tempfile.mkstemp(prefix=".kill-audit-", dir=os.path.dirname(path))
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as out:
            out.writelines(replacement if line.startswith(case + "\t") else line for line in lines)
        os.replace(temporary, path)
    finally:
        if os.path.exists(temporary):
            os.unlink(temporary)


def main():
    argv = sys.argv[1:]
    socket, command, rest = parse(argv)
    real = os.environ.get("IT_TMUX_REAL", "/usr/bin/tmux")
    ledger = os.environ.get("IT_TMUX_AUDIT_LEDGER")
    dirs = [os.path.realpath(p) for p in os.environ.get("IT_TMUX_AUDIT_PRIVATE_DIRS", "").split(":") if p]
    name = os.path.basename(socket)
    private = name not in ("default", "fleet", "fleet-davis") and any(
        os.path.commonpath((socket, directory)) == directory and socket != directory
        for directory in dirs)
    destructive = command in ("kill-server", "kill-session")
    creates = command in ("new-session", "new")
    indirect = can_dispatch_commands(command, rest)
    hidden_kills = nested_kills(rest) if indirect else []
    row = {"argv": argv, "socket": socket, "command": command,
           "target": option(rest, "-t"), "decision": "allow", "reason": ""}
    if not ledger:
        row.update(decision="deny", reason="no audit ledger")
        print("IT tmux audit: missing ledger", file=sys.stderr)
        return 97
    try:
        with open(ledger, "a+", encoding="utf-8") as stream:
            fcntl.flock(stream, fcntl.LOCK_EX)
            stream.seek(0)
            history = [json.loads(line) for line in stream if line.strip()]
            created = any(r.get("socket") == socket and r.get("created") for r in history)
            owned_inode = next((r["socket_inode"] for r in reversed(history)
                                if r.get("socket") == socket and r.get("socket_inode")), None)
            owned_pid = next((r["server_pid"] for r in reversed(history)
                              if r.get("socket") == socket and r.get("server_pid")), None)
            try:
                stat = os.stat(socket)
                current_inode = [stat.st_dev, stat.st_ino]
            except FileNotFoundError:
                current_inode = None
            current_pid = server_pid(real, socket) if private and created and current_inode \
                and (destructive or creates) else None
            session_ids = next((r["session_ids"] for r in reversed(history)
                                if r.get("socket") == socket and "session_ids" in r), {})
            if destructive or creates:
                if not private:
                    row.update(decision="deny", reason="socket outside section private directories or reserved name")
                elif creates and not created and os.path.exists(socket):
                    row.update(decision="deny", reason="server existed before section created it")
                elif destructive and not created:
                    row.update(decision="deny", reason="server not created by section")
                elif (destructive or creates) and created and current_inode and (
                        current_inode != owned_inode or
                        (owned_pid is not None and current_pid is not None and current_pid != owned_pid)):
                    row.update(decision="deny", reason="socket was replaced after section created it")
                elif destructive and current_inode is None:
                    row.update(decision="deny", reason="created socket no longer exists")
                elif command == "kill-session" and (not row["target"] or not row["target"].startswith("=")
                                                    or row["target"][1:] not in session_ids
                                                    or session_id(real, socket, row["target"][1:]) !=
                                                    session_ids.get(row["target"][1:])):
                    row.update(decision="deny", reason="session target is not an exact created session")
                elif creates and not option(rest, "-s"):
                    row.update(decision="deny", reason="new session has no auditable name")
            if indirect:
                row.update(decision="deny", reason="compound or server-side command dispatch is unauditable")
            if row["decision"] == "deny":
                denied_rows = [dict(row, status=97)]
                denied_rows.extend(dict(row, command=kill, target=None, nested=True, status=97)
                                   for kill in hidden_kills)
                stream.seek(0, os.SEEK_END)
                for denied in denied_rows:
                    stream.write(json.dumps(denied) + "\n")
                stream.flush()
                if destructive or hidden_kills:
                    refresh_result([*history, *denied_rows])
                print(f"IT tmux audit: refused {command}: {row['reason']}", file=sys.stderr)
                return 97
            if command in ("attach", "attach-session"):
                # An attached client may live for hours. Record its argv/socket, then release the
                # ledger lock before becoming tmux so every other invocation can proceed.
                row["status"] = "started"
                stream.seek(0, os.SEEK_END)
                stream.write(json.dumps(row) + "\n")
                stream.flush()
                fcntl.flock(stream, fcntl.LOCK_UN)
                stream.close()
                os.execv(real, [real, *argv])
            result = subprocess.run([real, *argv])
            row["status"] = result.returncode
            if result.returncode == 0 and private and (creates or created):
                row["created"] = True
                if creates:
                    try:
                        stat = os.stat(socket)
                        row["socket_inode"] = [stat.st_dev, stat.st_ino]
                        row["server_pid"] = server_pid(real, socket)
                    except FileNotFoundError:
                        row["created"] = False
                else:
                    row["socket_inode"] = owned_inode
                    row["server_pid"] = owned_pid
                owned_sessions = dict(session_ids)
                if command == "kill-server":
                    owned_sessions.clear()
                elif creates:
                    new_name = option(rest, "-s")
                    new_id = session_id(real, socket, new_name)
                    if new_id:
                        owned_sessions[new_name] = new_id
                elif command == "kill-session":
                    owned_sessions.pop(row["target"][1:], None)
                elif command == "rename-session":
                    old = option(rest, "-t")
                    renamed = rest[-1] if rest else ""
                    if old and old.startswith("=") and old[1:] in owned_sessions and renamed:
                        old_id = owned_sessions.pop(old[1:])
                        if session_id(real, socket, renamed) == old_id:
                            owned_sessions[renamed] = old_id
                row["session_ids"] = owned_sessions
                row["sessions"] = sorted(owned_sessions)
            stream.seek(0, os.SEEK_END)
            stream.write(json.dumps(row) + "\n")
            stream.flush()
            if destructive:
                refresh_result([*history, row])
            return result.returncode
    except (OSError, ValueError, json.JSONDecodeError) as exc:
        print(f"IT tmux audit: unavailable: {exc}", file=sys.stderr)
        return 97


if __name__ == "__main__":
    sys.exit(main())
