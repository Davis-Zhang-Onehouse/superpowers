#!/usr/bin/env python3
"""IT tmux boundary: log argv/socket and refuse unowned destructive calls before exec."""

import fcntl
import json
import os
import re
import socket as socketlib
import subprocess
import sys
import tempfile


def parse(argv):
    socket = None
    name = None
    shell_code = False
    control_mode = False
    i = 0
    while i < len(argv) and argv[i].startswith("-") and argv[i] not in ("-", "--"):
        option = argv[i]
        for offset, flag in enumerate(option[1:], 1):
            if flag == "C":
                control_mode = True
            if flag in "cfLST":
                value = option[offset + 1:]
                if not value:
                    i += 1
                    value = argv[i] if i < len(argv) else ""
                if flag == "S":
                    socket = value
                elif flag == "L":
                    name = value
                elif flag == "c":
                    shell_code = True
                break
        i += 1
    if i < len(argv) and argv[i] == "--":
        i += 1
    command = argv[i] if i < len(argv) else ""
    rest = argv[i + 1:]
    directory = os.environ.get("TMUX_TMPDIR") or "/tmp"
    if not os.path.isdir(directory):
        directory = "/tmp"
    if socket is None:
        if name:
            socket = os.path.join(directory, f"tmux-{os.getuid()}", name)
        elif os.environ.get("TMUX"):
            socket = os.environ["TMUX"].split(",", 1)[0]
        else:
            socket = os.path.join(directory, f"tmux-{os.getuid()}", "default")
    return os.path.realpath(socket), command, rest, shell_code, control_mode


# Names and aliases from tmux 3.2a cmd-*.c command entries. Keep the table pinned to
# the IT host's tmux version so unknown and ambiguous input fails closed.
TMUX_COMMANDS = frozenset("""
attach-session bind-key break-pane capture-pane clear-history choose-tree choose-client
choose-buffer customize-mode command-prompt confirm-before copy-mode clock-mode detach-client
suspend-client display-menu display-popup display-message display-panes find-window if-shell
join-pane move-pane kill-pane kill-server start-server kill-session kill-window
unlink-window list-buffers list-clients list-keys list-commands list-panes list-sessions
list-windows load-buffer lock-server lock-session lock-client move-window link-window
new-session has-session new-window paste-buffer pipe-pane refresh-client rename-session
rename-window resize-pane resize-window respawn-pane respawn-window rotate-window run-shell
save-buffer show-buffer select-layout next-layout previous-layout select-pane last-pane
select-window next-window previous-window last-window send-keys send-prefix set-buffer
delete-buffer set-environment set-option set-window-option set-hook show-environment show-messages
show-options show-window-options show-hooks source-file split-window swap-pane swap-window
switch-client unbind-key wait-for
""".split())
TMUX_ALIASES = dict(pair.split("=", 1) for pair in """
attach=attach-session bind=bind-key breakp=break-pane capturep=capture-pane clearhist=clear-history
confirm=confirm-before detach=detach-client suspendc=suspend-client
menu=display-menu popup=display-popup display=display-message displayp=display-panes findw=find-window
if=if-shell joinp=join-pane movep=move-pane killp=kill-pane
start=start-server killw=kill-window unlinkw=unlink-window lsb=list-buffers
lsc=list-clients lsk=list-keys lscm=list-commands lsp=list-panes ls=list-sessions
lsw=list-windows loadb=load-buffer lock=lock-server locks=lock-session lockc=lock-client
movew=move-window linkw=link-window new=new-session has=has-session neww=new-window
pasteb=paste-buffer pipep=pipe-pane refresh=refresh-client rename=rename-session renamew=rename-window
resizep=resize-pane resizew=resize-window respawnp=respawn-pane respawnw=respawn-window rotatew=rotate-window
run=run-shell saveb=save-buffer showb=show-buffer selectl=select-layout nextl=next-layout
prevl=previous-layout selectp=select-pane lastp=last-pane selectw=select-window
next=next-window prev=previous-window last=last-window send=send-keys setb=set-buffer
deleteb=delete-buffer setenv=set-environment set=set-option setw=set-window-option
showenv=show-environment showmsgs=show-messages show=show-options showw=show-window-options
source=source-file splitw=split-window swapp=swap-pane swapw=swap-window switchc=switch-client
unbind=unbind-key wait=wait-for
""".split())

# tmux 3.2a options-table.c: every OPTIONS_TABLE_{,PANE_,WINDOW_}HOOK entry.
# cmd-set-option.c sends set-option, set-window-option and set-hook through the
# same executor, so these option names can install commands too.
TMUX_HOOK_OPTIONS = frozenset("""
after-bind-key after-capture-pane after-copy-mode after-display-message after-display-panes
after-kill-pane after-list-buffers after-list-clients after-list-keys after-list-panes
after-list-sessions after-list-windows after-load-buffer after-lock-server after-new-session
after-new-window after-paste-buffer after-pipe-pane after-queue after-refresh-client
after-rename-session after-rename-window after-resize-pane after-resize-window after-save-buffer
after-select-layout after-select-pane after-select-window after-send-keys after-set-buffer
after-set-environment after-set-hook after-set-option after-show-environment after-show-messages
after-show-options after-split-window after-unbind-key alert-activity alert-bell alert-silence
client-attached client-detached client-resized client-session-changed pane-died pane-exited
pane-focus-in pane-focus-out pane-mode-changed pane-set-clipboard pane-title-changed
session-closed session-created session-renamed session-window-changed window-layout-changed
window-linked window-pane-changed window-renamed window-unlinked
""".split())


def canonical_command(command):
    if command in TMUX_COMMANDS:
        return command
    if command in TMUX_ALIASES:
        return TMUX_ALIASES[command]
    matches = [name for name in TMUX_COMMANDS if command and name.startswith(command)]
    return matches[0] if len(matches) == 1 else None


def option(rest, flag):
    for i, arg in enumerate(rest):
        if arg == flag and i + 1 < len(rest):
            return rest[i + 1]
        if arg.startswith(flag) and len(arg) > len(flag):
            return arg[len(flag):]
    return None


def nested_kills(rest):
    """Find kill words in arguments that tmux could execute as a later command."""
    found = []
    for arg in rest:
        for word in re.findall(r"[A-Za-z][A-Za-z-]*", arg):
            if len(word) >= 6 and "kill-server".startswith(word) and not "kill-session".startswith(word):
                found.append("kill-server")
            elif len(word) >= 6 and "kill-session".startswith(word):
                found.append("kill-session")
    return found


def set_option_operand(words, command):
    """Find the option name after tmux 3.2a set-option/set-window-option flags."""
    flags = "aFgopqsuUw" if command == "set-option" else "aFgoqu"
    i = 0
    while i < len(words):
        word = words[i]
        if word == "--":
            return words[i + 1] if i + 1 < len(words) else None
        if not word.startswith("-") or word == "-":
            return word
        for offset, flag in enumerate(word[1:], 1):
            if flag == "t":
                if offset == len(word) - 1:
                    i += 1
                    if i >= len(words):
                        return None
                break
            if flag not in flags:
                return None
        i += 1
    return None


def can_dispatch_commands(command, rest):
    # `rest` is the command's operands without the command word, for the first segment and every
    # later one alike (C-1).
    # A compound argv can execute a later command after the first one. These tmux commands can
    # execute commands supplied as arguments or from a file; their effect is not proved by argv[0].
    # new-session, new-window, split-window, respawn-pane/window and send-keys -X copy-pipe*
    # take shell operands but are allowed by design: tmux launched inside a pane is outside
    # this argv boundary, as documented for the IT harness.
    dispatchers = ("source-file", "if-shell", "confirm-before", "run-shell", "bind-key",
                   "set-hook", "command-prompt", "display-menu", "display-popup",
                   "display-panes", "choose-tree", "choose-client", "choose-buffer",
                   "pipe-pane", "detach-client")
    if command in dispatchers:
        return True
    if command not in ("set-option", "set-window-option"):
        return False
    operand = set_option_operand(rest, command)
    if operand is None:
        return True  # An unparsed option list cannot prove the value harmless.
    if "#" in operand:
        return True  # tmux expands the option name as a format before matching it.
    match = re.fullmatch(r"([^\[\]]+)(?:\[\d+\])?", operand)
    if match is None:
        return True
    name = match[1]
    return any(candidate.startswith(name) for candidate in
               (*TMUX_HOOK_OPTIONS, "command-alias"))


def split_tmux_commands(words):
    """Split tmux's argv separators, including an unescaped trailing semicolon."""
    parts = [[]]
    for arg in words:
        if arg == ";":
            parts.append([])
        elif arg.endswith(";") and not arg.endswith(r"\;"):
            parts[-1].append(arg[:-1])
            parts.append([])
        else:
            parts[-1].append(arg)
    return parts


def readonly_command(command, rest=()):
    if command in ("has-session", "ls", "lsc", "lsw", "lsp") or command.startswith(("list-", "show-")):
        return True
    if command in ("display-message", "capture-pane"):
        return "-p" in rest
    return False


def server_pid(real, socket):
    try:
        found = subprocess.run([real, "-S", socket, "display-message", "-p", "#{pid}"],
                               capture_output=True, text=True, timeout=2)
    except subprocess.TimeoutExpired:
        return None
    return found.stdout.strip() if found.returncode == 0 else None


def session_id(real, socket, name):
    try:
        found = subprocess.run([real, "-S", socket, "list-sessions", "-F",
                                "#{session_name}\t#{session_id}"], capture_output=True, text=True, timeout=2)
    except subprocess.TimeoutExpired:
        return None
    if found.returncode == 0:
        for line in found.stdout.splitlines():
            listed_name, _, listed_id = line.partition("\t")
            if listed_name == name and listed_id:
                return listed_id
    return None


def socket_accepts_connection(path):
    """A failed PID query is not proof of absence if the socket still accepts clients."""
    try:
        with socketlib.socket(socketlib.AF_UNIX, socketlib.SOCK_STREAM) as probe:
            probe.settimeout(0.2)
            return probe.connect_ex(path) == 0
    except OSError:
        return False


def refresh_result(rows):
    """A runner may kill in its EXIT trap, after its leave row was written."""
    path = os.environ.get("IT_TMUX_AUDIT_RESULTS")
    section = os.environ.get("IT_TMUX_AUDIT_SECTION")
    if not path or not section or not os.path.isfile(path):
        return
    case = f"KILL-AUDIT-{os.environ.get('IT_TMUX_AUDIT_CASE_SECTION') or section}"
    kills = [r for r in rows if r.get("command") in ("kill-server", "kill-session")]
    nonkill_denies = [r for r in rows if r.get("decision") == "deny" and
                     r.get("command") not in ("kill-server", "kill-session")]
    names = [r["command"] + "@" + os.path.basename(r["socket"]) +
             (":" + str(r["target"]) if r["target"] else "") + "[" + r["decision"] + "]"
             for r in kills]
    verdict = "FAIL" if any(r.get("decision") == "deny" for r in rows) else "PASS"
    note = f"{len(kills)} kill(s): " + (", ".join(names) if names else "(none)") + \
        f"; {len(nonkill_denies)} non-kill deny(s)"
    replacement = f"{case}\t{verdict}\tfleet/it/{section}/tmux-audit.jsonl\t{note}\n"
    with open(path + ".lock", "a", encoding="utf-8") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        with open(path, encoding="utf-8") as source:
            lines = source.readlines()
        if not any(line.startswith(case + "\t") for line in lines):
            return
        fd, temporary = tempfile.mkstemp(prefix=".kill-audit-", dir=os.path.dirname(path))
        try:
            with os.fdopen(fd, "w", encoding="utf-8") as out:
                out.writelines(replacement if line.startswith(case + "\t") else line for line in lines)
            os.replace(temporary, path)
        finally:
            if os.path.exists(temporary):
                os.unlink(temporary)


def main():
    argv = sys.argv[1:]
    socket, command, rest, shell_code, control_mode = parse(argv)
    real = os.environ.get("IT_TMUX_REAL", "/usr/bin/tmux")
    if os.path.realpath(real) == os.path.realpath(__file__):
        print("IT tmux audit: real tmux resolves to the audit shim", file=sys.stderr)
        return 97
    ledger = os.environ.get("IT_TMUX_AUDIT_LEDGER")
    dirs = [os.path.realpath(p) for p in os.environ.get("IT_TMUX_AUDIT_PRIVATE_DIRS", "").split(":") if p]
    name = os.path.basename(socket)
    private = name not in ("default", "fleet", "fleet-davis") and any(
        os.path.commonpath((socket, directory)) == directory and socket != directory
        for directory in dirs)
    raw_segments = split_tmux_commands([command, *rest])
    segments = [[canonical_command(part[0]) or "", *part[1:]] if part else []
                for part in raw_segments]
    command = segments[0][0] if segments[0] else ""
    rest = segments[0][1:] if segments[0] else []
    destructive = command in ("kill-server", "kill-session")
    creates = command in ("new-session", "new")
    # Only these calls read or change the ownership state the ledger carries. Every other call (capture-pane,
    # list-*, has-session ...) is decided from argv alone and records no state, so it never parses the ledger:
    # re-parsing it twice per call made a section's cost grow with the square of its call count (S7 §E).
    owns_state = destructive or creates or command == "rename-session"
    indirect = can_dispatch_commands(command, rest)
    leading_separator = not segments[0]
    # The dispatcher test on a later segment is defence in depth: no read-only command is a dispatcher today, so
    # a later dispatcher is already refused as non-read-only. It takes the same operand form as the first (C-1).
    compound_unsafe = any(part and (not readonly_command(part[0], part[1:]) or
                                    can_dispatch_commands(part[0], part[1:])) for part in segments[1:])
    hidden_kills = nested_kills([word for part in segments[1:] for word in part]) if compound_unsafe else []
    if indirect:
        hidden_kills.extend(nested_kills(segments[0]))
    if leading_separator:
        hidden_kills.extend(nested_kills(rest))
    if not command and raw_segments[0]:
        # A failed name lookup must not erase kill attribution from the raw argv.
        hidden_kills.extend(nested_kills(raw_segments[0]))
    shell_format = any("#(" in arg for arg in argv)
    if shell_format:
        hidden_kills.extend(nested_kills(rest))
    row = {"argv": argv, "socket": socket, "command": command,
           "target": option(rest, "-t"), "decision": "allow", "reason": ""}
    if not ledger:
        row.update(decision="deny", reason="no audit ledger")
        print("IT tmux audit: missing ledger", file=sys.stderr)
        return 97
    try:
        with open(ledger, "a+", encoding="utf-8") as stream:
            fcntl.flock(stream, fcntl.LOCK_EX)
            stream.seek(0)
            history = [json.loads(line) for line in stream if line.strip()] if owns_state else []
            created = any(r.get("socket") == socket and r.get("created") for r in history)
            owned_inode = next((r["socket_inode"] for r in reversed(history)
                                if r.get("socket") == socket and r.get("socket_inode")), None)
            owned_pid = next((r["server_pid"] for r in reversed(history)
                              if r.get("socket") == socket and r.get("server_pid")), None)
            try:
                stat = os.stat(socket)
                current_inode = [stat.st_dev, stat.st_ino]
            except FileNotFoundError:
                current_inode = None
            current_pid = server_pid(real, socket) if private and created and current_inode \
                and (destructive or creates) else None
            stale_owned_socket = bool((creates or destructive) and created and current_inode == owned_inode and
                                      owned_pid and current_pid is None and
                                      not socket_accepts_connection(socket))
            unverified_existing = creates and created and current_inode and (
                owned_pid is None or current_pid is None) and not stale_owned_socket
            session_ids = next((r["session_ids"] for r in reversed(history)
                                if r.get("socket") == socket and "session_ids" in r), {})
            if destructive or creates:
                if not private:
                    row.update(decision="deny", reason="socket outside section private directories or reserved name")
                elif creates and not created and os.path.exists(socket):
                    row.update(decision="deny", reason="server existed before section created it")
                elif destructive and not created:
                    row.update(decision="deny", reason="server not created by section")
                elif destructive and owned_inode and owned_pid and \
                        (current_inode is None or stale_owned_socket):
                    row.update(decision="noop", reason="owned server is already gone")
                elif destructive and (owned_pid is None or current_pid is None):
                    row.update(decision="deny", reason="created server PID cannot be verified")
                elif (destructive or creates) and created and current_inode and (
                        current_inode != owned_inode or
                        (current_pid is not None and owned_pid is not None and current_pid != owned_pid)):
                    row.update(decision="deny", reason="socket was replaced after section created it")
                elif destructive and current_inode is None:
                    row.update(decision="deny", reason="created socket no longer exists")
                elif command == "kill-session" and row["target"] and row["target"].startswith("=") and \
                        rest in (["-t", row["target"]], ["-t" + row["target"]]) and \
                        row["target"][1:] not in session_ids and \
                        any(r.get("socket") == socket and r.get("command") == "kill-session" and
                            r.get("target") == row["target"] and r.get("decision") == "allow" and
                            r.get("status") == 0 for r in history) and \
                        session_id(real, socket, row["target"][1:]) is None:
                    row.update(decision="noop", reason="previously owned session is already gone")
                elif command == "kill-session" and (not row["target"] or not row["target"].startswith("=")
                                                    or row["target"][1:] not in session_ids
                                                    or session_id(real, socket, row["target"][1:]) !=
                                                    session_ids.get(row["target"][1:])):
                    row.update(decision="deny", reason="session target is not an exact created session")
                elif command == "kill-session" and rest not in (["-t", row["target"]],
                                                                ["-t" + row["target"]]):
                    row.update(decision="deny", reason="session kill has unaudited options")
                elif creates and not option(rest, "-s"):
                    row.update(decision="deny", reason="new session has no auditable name")
            if not private and not readonly_command(command, segments[0]):
                row.update(decision="deny", reason="nonprivate socket permits read-only commands only")
            if not command:
                row.update(decision="deny", reason="unknown or ambiguous tmux command")
            if shell_format:
                row.update(decision="deny", reason="tmux format could execute a shell command")
            if shell_code:
                row.update(decision="deny", reason="global -c shell command is unauditable")
            if control_mode and not private:
                row.update(decision="deny", reason="control-mode stdin is unauditable on a foreign socket")
            if indirect or compound_unsafe or leading_separator:
                row.update(decision="deny", reason="compound or server-side command dispatch is unauditable")
            if row["decision"] == "noop":
                row["status"] = 1
                stream.seek(0, os.SEEK_END)
                stream.write(json.dumps(row) + "\n")
                stream.flush()
                refresh_result([*history, row])
                return 1
            if row["decision"] == "deny":
                denied_rows = [dict(row, status=97)]
                denied_rows.extend(dict(row, command=kill, target=None, nested=True, status=97)
                                   for kill in hidden_kills)
                stream.seek(0, os.SEEK_END)
                for denied in denied_rows:
                    stream.write(json.dumps(denied) + "\n")
                stream.flush()
                if destructive or hidden_kills:
                    if not owns_state:
                        stream.seek(0)
                        history = [json.loads(line) for line in stream if line.strip()]
                    refresh_result([*history, *denied_rows])
                print(f"IT tmux audit: refused {command}: {row['reason']}", file=sys.stderr)
                return 97
            if command in ("attach", "attach-session"):
                # An attached client may live for hours. Record its argv/socket, then release the
                # ledger lock before becoming tmux so every other invocation can proceed.
                row["status"] = "started"
                stream.seek(0, os.SEEK_END)
                stream.write(json.dumps(row) + "\n")
                stream.flush()
                fcntl.flock(stream, fcntl.LOCK_UN)
                stream.close()
                os.execv(real, [real, *argv])
            # A client may block waiting on a pane or server. Other audited calls must still be
            # able to read/write the ledger while the real executable runs.
            fcntl.flock(stream, fcntl.LOCK_UN)
            try:
                result = subprocess.run([real, *argv])
            finally:
                fcntl.flock(stream, fcntl.LOCK_EX)
            stream.seek(0, os.SEEK_END)
            size = stream.tell()
            needs_newline = size > 0 and os.pread(stream.fileno(), 1, size - 1) != b"\n"
            if not owns_state:
                row["status"] = result.returncode
                if needs_newline:
                    stream.write("\n")
                stream.write(json.dumps(row) + "\n")
                stream.flush()
                return result.returncode
            stream.seek(0)
            latest = []
            invalid_rows = 0
            needs_newline = False
            for line in stream:
                needs_newline = not line.endswith("\n")
                if not line.strip():
                    continue
                try:
                    latest.append(json.loads(line))
                except json.JSONDecodeError:
                    # The real command has already executed. Preserve its result row even if
                    # another writer damaged the ledger while the lock was released.
                    invalid_rows += 1
            if invalid_rows:
                row["reason"] = f"post-call ledger has {invalid_rows} invalid row(s)"
            session_ids = next((r["session_ids"] for r in reversed(latest)
                                if r.get("socket") == socket and "session_ids" in r), {})
            owned_inode = next((r["socket_inode"] for r in reversed(latest)
                                if r.get("socket") == socket and r.get("socket_inode")), owned_inode)
            owned_pid = next((r["server_pid"] for r in reversed(latest)
                              if r.get("socket") == socket and r.get("server_pid")), owned_pid)
            row["status"] = result.returncode
            if result.returncode == 0 and unverified_existing:
                # A stale socket may let tmux start a new server, but a new-session on an existing
                # socket cannot prove which server accepted it when the pre-call PID was unreadable.
                # Do not let the post-call PID turn that uncertain server into an owned one.
                row.update(created=False, reason="existing server PID was not verified before new-session")
            elif result.returncode == 0 and private and (creates or created):
                row["created"] = True
                if creates:
                    try:
                        stat = os.stat(socket)
                        row["socket_inode"] = [stat.st_dev, stat.st_ino]
                        row["server_pid"] = server_pid(real, socket)
                    except FileNotFoundError:
                        row["created"] = False
                else:
                    row["socket_inode"] = owned_inode
                    row["server_pid"] = owned_pid
                owned_sessions = dict(session_ids)
                if command == "kill-server":
                    owned_sessions.clear()
                elif creates:
                    new_name = option(rest, "-s")
                    new_id = session_id(real, socket, new_name)
                    if new_id:
                        owned_sessions[new_name] = new_id
                elif command == "kill-session":
                    owned_sessions.pop(row["target"][1:], None)
                elif command == "rename-session":
                    old = option(rest, "-t")
                    renamed = rest[-1] if rest else ""
                    if old and old.startswith("=") and old[1:] in owned_sessions and renamed:
                        old_id = owned_sessions.pop(old[1:])
                        if session_id(real, socket, renamed) == old_id:
                            owned_sessions[renamed] = old_id
                row["session_ids"] = owned_sessions
                row["sessions"] = sorted(owned_sessions)
            stream.seek(0, os.SEEK_END)
            if needs_newline:
                stream.write("\n")
            stream.write(json.dumps(row) + "\n")
            stream.flush()
            if destructive:
                refresh_result([*history, row])
            return result.returncode
    except (OSError, ValueError, json.JSONDecodeError) as exc:
        print(f"IT tmux audit: unavailable: {exc}", file=sys.stderr)
        return 97


if __name__ == "__main__":
    sys.exit(main())
