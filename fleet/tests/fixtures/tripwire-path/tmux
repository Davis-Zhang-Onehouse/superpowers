#!/usr/bin/env bash
# FB-118. The hermetic suite's `tmux`, first on PATH for every process the suite starts (`tests/__init__.py`).
# It resolves the server this call would reach the way tmux does — `-S path`, else `-L name` under
# $TMUX_TMPDIR/tmux-<uid> (or /tmp when that directory does not exist), else $TMUX's socket, else `default` there —
# and REFUSES (records on the tripwire log, exits 97, runs nothing) when that server is in FLEET_SUITE_FOREIGN_TMUX:
# the box's /tmp/tmux-<uid> always, plus the tmux directory and the $TMUX server of the shell that started the suite,
# i.e. the operator's live servers. Anything else is the real tmux.
real="${FLEET_SUITE_REAL_TMUX:-/usr/bin/tmux}"
server="" name=""
argv=("$@")
# A getopt cluster (`-uS path`, `-uSpath`, `-2L name`): the first of c/f/L/S/T takes the rest of the cluster, or the
# next argument, as its value and ends the cluster (RV-26).
while [ $# -gt 0 ]; do
  case "$1" in --|-) break ;; -*) ;; *) break ;; esac
  arg="$1"; shift; i=1
  while [ "$i" -lt "${#arg}" ]; do
    flag="${arg:$i:1}"
    case "$flag" in
      c|f|L|S|T)
        value="${arg:$((i+1))}"
        if [ -z "$value" ] && [ $# -gt 0 ]; then value="$1"; shift; fi
        [ "$flag" = S ] && server="$value"
        [ "$flag" = L ] && name="$value"
        break ;;
    esac
    i=$((i+1))
  done
done
# tmux uses TMUX_TMPDIR only when it names an existing directory, and /tmp otherwise (RV-25).
tmpdir="${TMUX_TMPDIR:-}"
[ -n "$tmpdir" ] && [ -d "$tmpdir" ] || tmpdir=/tmp
if [ -z "$server" ]; then
  if [ -n "$name" ]; then server="$tmpdir/tmux-$(id -u)/$name"
  elif [ -n "${TMUX:-}" ]; then server="${TMUX%%,*}"
  else server="$tmpdir/tmux-$(id -u)/default"
  fi
fi
server="$(realpath -m -- "$server")"
IFS=':' read -r -a foreign <<< "${FLEET_SUITE_FOREIGN_TMUX:-}"
for f in "${foreign[@]}"; do
  [ -n "$f" ] || continue
  f="$(realpath -m -- "$f")"
  if [ "$server" = "$f" ] || [ "$(dirname -- "$server")" = "$f" ]; then
    if [ -n "${FLEET_SUITE_TRIPWIRE:-}" ]; then
      printf 'tmux\t%s\t%s\n' "$server" "${argv[*]}" >> "$FLEET_SUITE_TRIPWIRE" 2>/dev/null
    fi
    echo "hermetic suite: refused tmux ${argv[*]} — it would reach $server, a server this suite did not create." >&2
    exit 97
  fi
done
exec "$real" "${argv[@]}"
