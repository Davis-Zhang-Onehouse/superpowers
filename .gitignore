.worktrees/
.private-journal/
.claude/
.superpowers/
.DS_Store
node_modules/
inspo
triage/

# Eval harness lives in its own repository, cloned into evals/ for local
# development (see CLAUDE.md / README.md). It is not part of the published
# plugin, so the whole directory is ignored here.
evals/

# in the fleetInfraRebuild instant.
fleet/it/*/home/
fleet/it/*/slot/
fleet/it/RESULTS-closeout-*.tsv
__pycache__/
*.pyc


# sessions observed). Established on first run by it/lib.sh and machine-local by nature — another checkout
# has different sessions, so committing them would fail every fresh clone on its first run.
fleet/it/live-tmux-sessions.txt

# fleet integration harness. Every SUBDIRECTORY of fleet/it/ is generated section output — section trees,
# leased slots, unpacked fixtures, real git repos built by a runner — and the runners regenerate all of it.
# The only committed subdirectories are the controls and the archived dummy-project fixture.
#
# Structural rather than a list of names: a named rule was written twice and slipped twice (§C's fixture
# repos, §LB's slot), because each new section invents its own directory and nothing reminds you.
fleet/it/*/
!fleet/it/bin/
!fleet/it/fixtures/

# Box-local baselines, established on first run by it/lib.sh: another checkout has different live sessions.
fleet/it/live-stores.sha256
fleet/it/live-tmux-sessions.txt
# The instants-directory baseline, the third live resource `it_assert_isolation` compares (I2-11).
# A snapshot of THIS BOX's live effort trees, exactly like the two above, so it cannot be committed.
fleet/it/live-instants*.txt
fleet/it/dt-sessions-seen*.txt
# Per-run results files; RESULTS.tsv is the merged current state and IS committed.
fleet/it/RESULTS-*.tsv
fleet/it/*.log

# Per-run SOURCE PIN scratch, written by fleet/it/bin/source-pin.sh on every runner invocation.
# NOT registers — they record "what the tree looked like at this run" and are meaningless once it ends.
# They are gitignored rather than committed because committing them is what makes a tracked file show `M`
# on every run FOREVER: SOURCE-PIN-group5-{before,after}.txt were cleared that way once, and each new
# refusal then tempts the next person to `git add` one more. A dirty tree REFUSES `release cut`
# (release_git.Repo.dirty counts untracked too), so this is a release-gate fix, not tidiness.
fleet/it/SOURCE-PIN-*.txt
fleet/it/SOURCE-CONTAMINATED.txt
